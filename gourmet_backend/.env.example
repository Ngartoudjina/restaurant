# ──────────────────────────────────────────────────────────────
# Configuration backend Le Gourmet — copier en .env et remplir.
# NE JAMAIS committer le vrai .env (il est dans .gitignore).
# ──────────────────────────────────────────────────────────────

# Environnement
NODE_ENV=development
PORT=5000

# Origine(s) autorisée(s) pour CORS (séparées par des virgules en prod)
FRONTEND_URL=http://localhost:8080

# Firebase Admin — coller le JSON du service account sur UNE seule ligne
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Cloudinary (upload d'images produits)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Redis (cache) — optionnel en local
REDIS_URL=redis://localhost:6379
